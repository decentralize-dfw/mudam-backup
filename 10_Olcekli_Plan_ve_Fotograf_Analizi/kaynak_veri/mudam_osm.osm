  <tag k="note" v="Biserica este situată aproximativ sub podul Grande-Duchesse Charlotte (podul roșu), care leagă centrul orașului de cartierul Kirchberg. Se poate ajunge cu autobuzul nr. 19 de la stația Centre-Hamilius până la stația Pfaffenthal-Theiwesbur (aprox.7 min.)"/>
  <tag k="office" v="religion"/>
  <tag k="opening_hours" v="Fr 16:00-20:00; Sa 18:00-19:00; Su 11:00-13:30"/>
  <tag k="phone" v="+352 25 10 54"/>
  <tag k="religion" v="christian"/>
  <tag k="source" v="http://www.mitropolia-ro.de/index.php/parohii/parohii-luxemburg"/>
  <tag k="website" v="https://www.biserica.lu/"/>
 </node>
