# Local Python runtime dependencies and caches
**/.deps/
**/__pycache__/
*.py[cod]
.venv/
venv/

# Local credentials and operating-system files
.env
.env.*
!.env.example
Thumbs.db
Desktop.ini
.DS_Store

# Regenerable Blender console logs
12_Blender_Model/reports/*_build.log
12_Blender_Model/reports/*_verify.log

# Superseded local trials, retained on disk; only verified checkpoints are published
12_Blender_Model/scenes/archive/local_trials_20261008/
12_Blender_Model/reports/*.log

# Blender and versioned exports stay local; only one lossless web preview is published.
12_Blender_Model/scenes/**/*.blend
12_Blender_Model/scenes/*.blend
12_Blender_Model/exports/*.glb
12_Blender_Model/exports/*.gltf
12_Blender_Model/exports/*.bin
12_Blender_Model/exports/*.fbx
12_Blender_Model/exports/*.obj

12_Blender_Model/exports/*.glb.gz
!12_Blender_Model/exports/current.glb.gz
12_Blender_Model/exports/*.tmp

# Local research downloads that are not accepted model sources
12_Blender_Model/.local_source_cache/
# Full 210-page archive stays local; relevant Mudam pages and provenance are published.
12_Blender_Model/references/ABP_centenaire.pdf

# Web demo build tooling (the staged output lives in index.html and demo/)
web/node_modules/
web/dist/

# Local R151 web packages and intermediate layer binaries
12_Blender_Model/exports/r151_web*/
12_Blender_Model/exports/MUDAM_R151_WEB_PAKETI_*.zip

12_Blender_Model/exports/MUDAM_R151_WEB_CLEAN_PAKETI_*.zip
12_Blender_Model/exports/r152_clean/
